# Copier ce fichier en .env puis adapter les valeurs.
PORT=3000

# Fuseau horaire du site (les heures sont enregistrées en heure locale du site)
TZ=Europe/Paris

# Base MySQL 8.0+ (ou MariaDB 10.5+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hopital
DB_USER=hopital
DB_PASSWORD=changez-moi

# Clé de signature des sessions : au moins 32 caractères aléatoires.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 1 si le site est servi en HTTPS (recommandé, obligatoire hors réseau local)
COOKIE_SECURE=0
# 1 si le serveur est derrière un proxy inverse (nginx, Traefik...) pour lire la vraie adresse IP des clients
TRUST_PROXY=0
# Premier administrateur créé par db:init si la base n'a aucun utilisateur (12 caractères minimum)
ADMIN_PASSWORD=
# Durée d'une session en heures
SESSION_HEURES=12
