{
  "name": "hopital-de-campagne",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion d'un hôpital de campagne : admissions, dossiers médicaux, blocs opératoires (Node.js + MySQL)",
  "main": "src/server.js",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "db:init": "node --env-file=.env scripts/init-db.js",
    "db:seed": "node --env-file=.env scripts/seed-demo.js",
    "user:add": "node --env-file=.env scripts/add-user.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  }
}
